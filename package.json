{
  "name": "@deepwhale-cn/dsh-plugin-updater",
  "version": "0.2.1",
  "description": "检查并更新第三方 DSH 插件：对比 npm 最新版本，一条命令精确升级（绕过 pnpm 新版本观察期）",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0",
    "node": ">=20"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin-manager",
    "update",
    "upgrade",
    "deepwhale"
  ],
  "license": "MIT",
  "author": "温州深鲸智能科技有限公司 <contact@deepwhale.org.cn>",
  "homepage": "https://deepwhale.org.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-plugin-updater.git"
  },
  "icon": "./icon.svg",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "meta": {
    "title": "插件更新",
    "description": "检查第三方 DSH 插件是否有新版本，并精确升级到最新版（不用卸载重装）。"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  }
}